---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkView from '../../../views/WorkView.astro';
import { works } from '../../../data/works';

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
---

<BaseLayout
  locale="ua"
  title={`${work.titleUa} — Юлія Поліщук`}
  description={work.descriptionUa ?? `Акварельна робота «${work.titleUa}» художниці Юлії Поліщук.`}
>
  <WorkView locale="ua" work={work} />
</BaseLayout>
