---
import type { Locale } from '../i18n';
import { statusLabel } from '../i18n';
import type { WorkStatus } from '../data/works';

interface Props {
  status: WorkStatus;
  locale: Locale;
}

const { status, locale } = Astro.props;

const styles: Record<WorkStatus, string> = {
  available: 'bg-teal-tint text-teal-strong',
  sold: 'bg-line text-ink-soft',
  'on-request': 'bg-terracotta-tint text-terracotta',
};
---

<span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-label uppercase tracking-wider ${styles[status]}`}>
  {statusLabel(locale, status)}
</span>
