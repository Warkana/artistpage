---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
}

const { images, alt } = Astro.props;

const slides = await Promise.all(
  images.map(async (image) => {
    const full = await getImage({ src: image, width: 1600, format: 'webp' });
    const thumb = await getImage({ src: image, width: 700, format: 'webp' });
    return {
      fullSrc: full.src,
      fullWidth: full.attributes.width,
      fullHeight: full.attributes.height,
      thumbSrc: thumb.src,
      thumbWidth: thumb.attributes.width,
      thumbHeight: thumb.attributes.height,
    };
  })
);
---

<div id="work-gallery" class="pswp-gallery grid grid-cols-2 gap-3 sm:grid-cols-3">
  {slides.map((s, i) => (
    <a
      href={s.fullSrc}
      data-pswp-width={s.fullWidth}
      data-pswp-height={s.fullHeight}
      class={`block overflow-hidden rounded-lg bg-line ${i === 0 ? 'col-span-2 row-span-2 sm:col-span-2 sm:row-span-2' : ''}`}
    >
      <img
        src={s.thumbSrc}
        width={s.thumbWidth}
        height={s.thumbHeight}
        alt={i === 0 ? alt : `${alt} — ${i + 1}`}
        loading={i === 0 ? 'eager' : 'lazy'}
        class="h-full w-full object-cover"
      />
    </a>
  ))}
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#work-gallery',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
</script>
