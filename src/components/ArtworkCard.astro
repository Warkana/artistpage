---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n';
import { localePath } from '../i18n';
import type { Work } from '../data/works';
import StatusBadge from './StatusBadge.astro';

interface Props {
  work: Work;
  locale: Locale;
  /** eager-load for above-the-fold cards (e.g. hero picks) */
  eager?: boolean;
}

const { work, locale, eager = false } = Astro.props;
const title = locale === 'ua' ? work.titleUa : work.titleEn;
const href = localePath(locale, `works/${work.slug}`);
---

<a href={href} class="group block">
  <div class="relative aspect-[4/5] overflow-hidden rounded-md bg-line">
    <Image
      src={work.image}
      alt={title}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 320px, (min-width: 640px) 45vw, 90vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
    <div class="absolute left-3 top-3">
      <StatusBadge status={work.status} locale={locale} />
    </div>
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="font-display text-lg text-ink">{title}</h3>
    {work.series && <span class="font-label text-[11px] uppercase tracking-wide text-ink-soft">{work.series}</span>}
  </div>
</a>
