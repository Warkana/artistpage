---
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).about;
---

<section class="mx-auto max-w-4xl px-5 py-14 sm:py-20">
  <h1 class="font-display text-3xl text-ink sm:text-4xl">{copy.title}</h1>

  <div class="mt-10 grid gap-10 sm:grid-cols-[220px_1fr] sm:items-start">
    <!-- TODO: replace with a real portrait photo of Julia. -->
    <div class="flex aspect-[4/5] w-full items-center justify-center rounded-lg border border-dashed border-line bg-surface text-center">
      <span class="px-4 font-label text-[11px] uppercase tracking-wide text-ink-soft">
        {locale === 'ua' ? 'Фото художниці — додати' : "Artist's photo — to add"}
      </span>
    </div>

    <div>
      <p class="text-[15.5px] leading-relaxed text-ink-soft">{copy.bio}</p>

      <h2 class="mt-8 font-display text-lg text-ink">{copy.statementTitle}</h2>
      <p class="mt-3 text-[15.5px] leading-relaxed text-ink-soft">{copy.statement}</p>
    </div>
  </div>
</section>
