---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n';
import { t, localePath } from '../i18n';
import { works } from '../data/works';
import ArtworkCard from '../components/ArtworkCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const featured = works[0];
const selection = works.slice(0, 6);
const featuredTitle = locale === 'ua' ? featured.titleUa : featured.titleEn;
---

<section class="relative">
  <div class="relative h-[78vh] min-h-[480px] max-h-[820px] w-full overflow-hidden bg-ink">
    <Image
      src={featured.image}
      alt={featuredTitle}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      class="h-full w-full object-cover opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent"></div>

    <div class="absolute inset-x-0 bottom-0 px-5 pb-12 sm:px-10">
      <div class="mx-auto max-w-6xl">
        <p class="font-label text-[12px] uppercase tracking-[0.2em] text-surface/80">{copy.hero.eyebrow}</p>
        <h1 class="mt-3 max-w-xl font-display text-4xl text-surface sm:text-5xl">{copy.hero.title}</h1>
        <p class="mt-3 max-w-md text-base text-surface/85">{copy.hero.tagline}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={localePath(locale, 'gallery')}
            class="rounded-full bg-surface px-6 py-2.5 font-label text-[13px] uppercase tracking-wide text-ink hover:bg-paper"
          >
            {copy.hero.ctaGallery}
          </a>
          <a
            href={localePath(locale, 'contact')}
            class="rounded-full border border-surface/60 px-6 py-2.5 font-label text-[13px] uppercase tracking-wide text-surface hover:border-surface"
          >
            {copy.hero.ctaContact}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-3xl px-5 py-16 text-center sm:py-20">
  <h2 class="font-display text-2xl text-ink">{copy.aboutTeaser.title}</h2>
  <p class="mt-4 text-[15.5px] leading-relaxed text-ink-soft">{copy.about.bio}</p>
  <a href={localePath(locale, 'about')} class="mt-5 inline-block font-label text-[13px] uppercase tracking-wide text-teal-strong hover:underline">
    {copy.aboutTeaser.more} →
  </a>
</section>

<section class="mx-auto max-w-6xl px-5 pb-20">
  <div class="flex items-baseline justify-between">
    <h2 class="font-display text-2xl text-ink">{copy.selection.title}</h2>
    <a href={localePath(locale, 'gallery')} class="font-label text-[12px] uppercase tracking-wide text-ink-soft hover:text-teal-strong">
      {copy.selection.viewAll} →
    </a>
  </div>
  <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 sm:grid-cols-3">
    {selection.map((work) => <ArtworkCard work={work} locale={locale} />)}
  </div>
</section>

<section class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-4 px-5 py-16 text-center">
    <h2 class="font-display text-2xl text-ink">{copy.ctaBand.title}</h2>
    <p class="max-w-md text-[15px] text-ink-soft">{copy.ctaBand.text}</p>
    <a
      href={localePath(locale, 'contact')}
      class="mt-2 rounded-full bg-teal px-7 py-3 font-label text-[13px] uppercase tracking-wide text-surface hover:bg-teal-strong"
    >
      {copy.ctaBand.button}
    </a>
  </div>
</section>
